//parental state shared across bottle replicates
//burnin/divergence times are simulation parameters, not species split estimates

initialize() {
    if (!exists("N_ANC"))     defineConstant("N_ANC", 5000);
    if (!exists("N_SIM"))     defineConstant("N_SIM", 5000);
    if (!exists("N_SEC"))     defineConstant("N_SEC", 500);   // smaller sechellia Ne proxy
    if (!exists("BURNIN"))    defineConstant("BURNIN", 50000);
    if (!exists("DIV_GENS"))  defineConstant("DIV_GENS", 50000);
    if (!exists("MU"))        defineConstant("MU", 1.5e-9);
    if (!exists("BASE_R"))    defineConstant("BASE_R", 2.3e-8);
    if (!exists("STATEFILE")) defineConstant("STATEFILE", "parental_13MB.bin");

    defineConstant("CHR_END", 12999999);

    initializeSex("A");
    initializeMutationRate(MU);

    initializeMutationType("m1", 0.5, "f", 0.0);
    m1.convertToSubstitution = F;

    initializeGenomicElementType("g1", m1, 1.0);
    initializeGenomicElement(g1, 0, CHR_END);

    initializeRecombinationRate(BASE_R, sex="F");
    initializeRecombinationRate(0.0,    sex="M");
}

1 early() {
    sim.addSubpop("p1", N_ANC, 0.5);
}

1:1000000 early() {
    if (sim.generation == (BURNIN + 1)) {
        p1.setSubpopulationSize(N_SIM);

        sim.addSubpopSplit("p2", N_SEC, p1, 0.5);
        catn("# split at generation " + sim.generation +
             "; N_sim=" + N_SIM + "; N_sec=" + N_SEC);
    }
}

1:1000000 late() {
    endGen = BURNIN + DIV_GENS + 1;
    if (sim.generation == endGen) {
        catn("# writing parental state at generation " + sim.generation +
             " to " + STATEFILE);
        sim.outputFull(STATEFILE, binary=T);
        sim.simulationFinished();
    }
}
